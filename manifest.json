{
  "manifest_version": 3,
  "name": "Windify",
  "version": "1.1.0",
  "description": "Windy31 на каждом превью YouTube.",
  "author": "Rell10N",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "ico.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "windify@rell10n.addon",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "128": "ico.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["windy.png"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}